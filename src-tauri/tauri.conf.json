{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MakrStudio",
  "version": "0.1.0",
  "identifier": "com.makesoftware.makepresent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MakrStudio - Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "showMenuOnLeftClick": false,
      "tooltip": "MakrStudio"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "publisher": "MakeMission",
    "category": "Productivity",
    "shortDescription": "Live presentation software for churches",
    "longDescription": "MakrStudio by MakeMission - presentation app with live output, stage display, and scripture integration.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libxcb1",
          "libxrandr2",
          "libdbus-1-3",
          "libwayland-client0",
          "libegl1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "resources/kjv.json": "kjv.json",
      "resources/NDI_Runtime_V6.exe": "NDI_Runtime_V6.exe",
      "resources/NDI_VERSION.txt": "NDI_VERSION.txt",
      "../src/assets/fonts/ArchivoBlack-Regular.ttf": "fonts/ArchivoBlack-Regular.ttf",
      "../src/assets/fonts/ArchivoBlack-OFL.txt": "fonts/ArchivoBlack-OFL.txt",
      "../src/assets/fonts/Inter-Regular.ttf": "fonts/Inter-Regular.ttf",
      "../src/assets/fonts/Inter-Medium.ttf": "fonts/Inter-Medium.ttf",
      "../src/assets/fonts/Inter-Bold.ttf": "fonts/Inter-Bold.ttf",
      "../src/assets/fonts/Inter-OFL.txt": "fonts/Inter-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./windows/hooks.nsi"
      },
      "wix": {
        "language": "en-US"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}

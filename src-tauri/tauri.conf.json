{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MakePresent",
  "version": "0.1.0",
  "identifier": "com.makesoftware.makepresent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MakePresent - Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "showMenuOnLeftClick": false,
      "tooltip": "MakePresent"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/kjv.json": "kjv.json",
      "../src/assets/fonts/ArchivoBlack-Regular.ttf": "fonts/ArchivoBlack-Regular.ttf",
      "../src/assets/fonts/ArchivoBlack-OFL.txt": "fonts/ArchivoBlack-OFL.txt",
      "../src/assets/fonts/Inter-Regular.ttf": "fonts/Inter-Regular.ttf",
      "../src/assets/fonts/Inter-Medium.ttf": "fonts/Inter-Medium.ttf",
      "../src/assets/fonts/Inter-Bold.ttf": "fonts/Inter-Bold.ttf",
      "../src/assets/fonts/Inter-OFL.txt": "fonts/Inter-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}